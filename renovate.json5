{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for Terraform monorepo with distinct commit and PR titles per cluster group",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Dependency Dashboard (Terraform Modules)",
  "terragrunt": {
    "enabled": false
  },
  "github-actions": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)terragrunt\\.hcl$"
      ],
      "matchStrings": [
        "source\\s*=\\s*\"git::https://github\\.com/(?<repo>[\\w-]+/[\\w-]+)\\.git//(?<depName>[\\w/-]+)\\?ref=modules/(?<packageName>[\\w-]+)-(?<tagPrefix>v)(?<currentValue>[\\d\\.]+)\""
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "{{{repo}}}",
      "packageNameTemplate": "https://github.com/{{{repo}}}.git",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^modules/{{packageName}}-v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["terragrunt/deployments/development/**"],
      "groupName": "Canary Dev Clusters",
      "commitMessageTopic": "Dev Clusters (madmax/alpha)",
      "prTitle": "chore(deps): bump modules in Dev Clusters (madmax/alpha) to {{newVersion}}"
    },
    {
      "matchFileNames": ["terragrunt/deployments/staging/**"],
      "groupName": "Staging Clusters",
      "commitMessageTopic": "Staging Clusters",
      "prTitle": "chore(deps): bump modules in Staging Clusters to {{newVersion}}"
    },
    {
      "matchFileNames": ["terragrunt/deployments/production/**"],
      "groupName": "Production Clusters",
      "commitMessageTopic": "Production Clusters",
      "prTitle": "chore(deps): bump modules in Production Clusters to {{newVersion}}"
    }
  ]
}

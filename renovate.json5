{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration with individual per-cluster granular controls",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Dependency Dashboard (Terraform Modules)",
  "terragrunt": {
    "enabled": false
  },
  "github-actions": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)terragrunt\\.hcl$"
      ],
      "matchStrings": [
        "source\\s*=\\s*\"git::https://github\\.com/(?<repo>[\\w-]+/[\\w-]+)\\.git//(?<depName>[\\w/-]+)\\?ref=modules/(?<packageName>[\\w-]+)-(?<tagPrefix>v)(?<currentValue>[\\d\\.]+)\""
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "{{{repo}}}",
      "packageNameTemplate": "https://github.com/{{{repo}}}.git",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^modules/{{packageName}}-v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Granular rule for Dev cluster madmax only",
      "matchFileNames": ["terragrunt/deployments/development/zedcloud-madmax/**"],
      "groupName": "Cluster: madmax",
      "commitMessageTopic": "Cluster madmax"
    },
    {
      "description": "Granular rule for Dev cluster alpha only",
      "matchFileNames": ["terragrunt/deployments/development/zedcloud-alpha/**"],
      "groupName": "Cluster: alpha",
      "commitMessageTopic": "Cluster alpha"
    },
    {
      "description": "Granular rule for Staging cluster only",
      "matchFileNames": ["terragrunt/deployments/staging/zedcloud-staging/**"],
      "groupName": "Cluster: staging",
      "commitMessageTopic": "Cluster staging"
    },
    {
      "description": "Granular rule for Production cluster only",
      "matchFileNames": ["terragrunt/deployments/production/zedcloud-production/**"],
      "groupName": "Cluster: production",
      "commitMessageTopic": "Cluster production"
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration with true per-file branch separation for independent cluster checkboxes",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Dependency Dashboard (Terraform Modules)",
  "terragrunt": {
    "enabled": false
  },
  "github-actions": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)terragrunt\\.hcl$"
      ],
      "matchStrings": [
        "source\\s*=\\s*\"git::https://github\\.com/(?<repo>[\\w-]+/[\\w-]+)\\.git//(?<depName>[\\w/-]+)\\?ref=modules/(?<packageName>[\\w-]+)-(?<tagPrefix>v)(?<currentValue>[\\d\\.]+)\""
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "{{{repo}}}",
      "packageNameTemplate": "https://github.com/{{{repo}}}.git",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^modules/{{packageName}}-v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Ensure distinct branch names and dashboard rows for every cluster deployment file",
      "matchManagers": ["custom.regex"],
      "additionalBranchPrefix": "{{replace 'terragrunt/deployments/' '' packageFileDir}}-"
    }
  ]
}
